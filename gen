@dp.inline_query()
async def inline_query_handler(query: InlineQuery):
    """Inline query syntax: 'check 100' or 'request 100'. Inline check is a deep-link claim."""
    await register_user(query.from_user)
    text = (query.query or "").strip()
    match = re.fullmatch(r"(check|request)\s+(\d+)", text, re.IGNORECASE)
    results = []
    if match:
        action, raw_amount = match.group(1).lower(), int(match.group(2))
        if 0 < raw_amount <= 10**9:
            if action == "check":
                token = await create_check_inline(query.from_user.id, raw_amount)
                if token:
                    link = f"https://t.me/{bot_username}?start=claim_{token}"
                    content = (f"🔷 ENEX · ЧЕК\n\n💎 Сумма: {money(raw_amount)} ENEX\n"
                               "🎁 Чек на одного получателя\nНажми кнопку, чтобы забрать.")
                    markup = InlineKeyboardMarkup(inline_keyboard=[
                        [InlineKeyboardButton(text=f"🎁 Забрать {money(raw_amount)} ENEX", url=link)]
                    ])
                    results.append(InlineQueryResultArticle(
                        id=f"check_{token}", title=f"🎁 Чек на {money(raw_amount)} ENEX",
                        description="Создать чек и отправить его в этот чат",
                        input_message_content=InputTextMessageContent(message_text=content),
                        reply_markup=markup))
                else:
                    results.append(InlineQueryResultArticle(
                        id="no_funds", title="Недостаточно ENEX",
                        input_message_content=InputTextMessageContent(
                            message_text="❌ Недостаточно ENEX для создания чека.")))
            else:
                token = await create_request_inline(query.from_user.id, raw_amount)
                link = f"https://t.me/{bot_username}?start=payreq_{token}"
                content = (f"🔷 ENEX · ЗАПРОС ДЕНЕГ\n\n💸 Запрошено: {money(raw_amount)} ENEX\n"
                           f"От: {query.from_user.full_name}")
                markup = InlineKeyboardMarkup(inline_keyboard=[
                    [InlineKeyboardButton(text=f"💸 Оплатить {money(raw_amount)} ENEX", url=link)]
                ])
                results.append(InlineQueryResultArticle(
                    id=f"request_{token}", title=f"💸 Запрос {money(raw_amount)} ENEX",
                    description="Отправить запрос денег в этот чат",
                    input_message_content=InputTextMessageContent(message_text=content),
                    reply_markup=markup))
    if not results:
        results = [
            InlineQueryResultArticle(
                id="help_check", title="🎁 Создать чек",
                description="Введите: check 100",
                input_message_content=InputTextMessageContent(
                    message_text=f"Чтобы создать чек, введи в inline: @{bot_username} check 100")),
            InlineQueryResultArticle(
                id="help_request", title="💸 Запросить деньги",
                description="Введите: request 100",
                input_message_content=InputTextMessageContent(
                    message_text=f"Чтобы создать запрос, введи: @{bot_username} request 100"))
        ]
    await query.answer(results, cache_time=0, is_personal=True)


async def create_check_inline(user_id: int, amount: int):
    token = secrets.token_urlsafe(9).replace("-", "").replace("_", "")[:12]
    async with aiosqlite.connect(DB_PATH) as db:
        cur = await db.execute("SELECT balance,active FROM users WHERE user_id=?", (user_id,))
        row = await cur.fetchone()
        if not row or not row[1] or row[0] < amount:
            return None
        # Pending only: typing an inline query must not charge the user.
        await db.execute(
            "INSERT INTO checks(token,creator_id,amount,remaining,status,created_at) VALUES(?,?,?,?,?,?)",
            (token, user_id, amount, amount, "pending",
             datetime.now(timezone.utc).isoformat()))
        await db.commit()
    return token


async def create_request_inline(user_id: int, amount: int):
    token = secrets.token_urlsafe(9).replace("-", "").replace("_", "")[:12]
    async with aiosqlite.connect(DB_PATH) as db:
        await db.execute(
            "INSERT INTO requests(token,creator_id,target_id,amount,created_at) VALUES(?,?,?,?,?)",
            (token, user_id, None, amount, datetime.now(timezone.utc).isoformat()))
        await db.commit()
    return token


@dp.chosen_inline_result()
async def chosen_inline_result_handler(result: ChosenInlineResult):
    # Enable Inline Feedback in @BotFather (/setinlinefeedback).
    result_id = result.result_id or ""
    if not result_id.startswith("check_"):
        return
    token = result_id[len("check_"):]
    uid = result.from_user.id
    async with aiosqlite.connect(DB_PATH) as db:
        await db.execute("BEGIN IMMEDIATE")
        cur = await db.execute(
            "SELECT creator_id,amount,status FROM checks WHERE token=?", (token,))
        row = await cur.fetchone()
        if not row or row[0] != uid or row[2] != "pending":
            await db.rollback()
            return
        cur = await db.execute("SELECT balance,active FROM users WHERE user_id=?", (uid,))
        user = await cur.fetchone()
        if not user or not user[1] or user[0] < row[1]:
            await db.execute("UPDATE checks SET status='cancelled',remaining=0 WHERE token=?", (token,))
            await db.commit()
            return
        await db.execute("UPDATE users SET balance=balance-? WHERE user_id=?", (row[1], uid))
        await db.execute("UPDATE checks SET status='open' WHERE token=?", (token,))
        await log_tx(db, uid, "check_create_inline", -row[1], f"token={token}")
        await db.commit()


@dp.message(Command("promo"))
async def redeem_promo(message: Message):
    await register_user(message.from_user)
    parts = (message.text or "").split(maxsplit=1)
    if len(parts) != 2:
        await message.answer("Формат: /promo КОД")
        return
    code = parts[1].strip().upper()
    uid = message.from_user.id
    async with aiosqlite.connect(DB_PATH) as db:
        await db.execute("BEGIN IMMEDIATE")
        db.row_factory = aiosqlite.Row
        cur = await db.execute("SELECT * FROM promos WHERE code=?", (code,))
        promo = await cur.fetchone()
        if not promo or not promo["active"] or promo["uses"] >= promo["max_uses"]:
            await db.rollback()
            await message.answer("❌ Промокод недействителен или активации закончились.")
            return
        cur = await db.execute("SELECT 1 FROM promo_uses WHERE code=? AND user_id=?", (code, uid))
        if await cur.fetchone():
            await db.rollback()
            await message.answer("Ты уже активировал этот промокод.")
            return
        cur = await db.execute("SELECT active FROM users WHERE user_id=?", (uid,))
        user = await cur.fetchone()
        if not user or not user[0]:
            await db.rollback()
            await message.answer("Аккаунт недоступен.")
            return
        await db.execute("UPDATE users SET balance=balance+? WHERE user_id=?", (promo["amount"], uid))
        await db.execute("UPDATE promos SET uses=uses+1 WHERE code=?", (code,))
        await db.execute("INSERT INTO promo_uses(code,user_id,created_at) VALUES(?,?,?)",
                          (code, uid, datetime.now(timezone.utc).isoformat()))
        await log_tx(db, uid, "promo", promo["amount"], f"code={code}")
        await db.commit()
    await message.answer(f"🎉 Промокод активирован! Начислено <b>{money(promo['amount'])} ENEX</b>.", parse_mode="HTML")


