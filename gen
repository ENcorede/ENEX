async def create_check(message: Message, amount: int, inline=False):
    uid = message.from_user.id
    if amount <= 0:
        return None
    token = secrets.token_urlsafe(9).replace("-", "").replace("_", "")[:12]
    async with aiosqlite.connect(DB_PATH) as db:
        await db.execute("BEGIN IMMEDIATE")
        cur = await db.execute("SELECT balance FROM users WHERE user_id=?", (uid,))
        row = await cur.fetchone()
        if not row or row[0] < amount:
            await db.rollback()
            if not inline:
                await message.answer("Недостаточно ENEX для создания чека.")
            return None
        await db.execute("UPDATE users SET balance=balance-? WHERE user_id=?", (amount, uid))
        await db.execute(
            "INSERT INTO checks(token,creator_id,amount,remaining,created_at) VALUES(?,?,?,?,?)",
            (token, uid, amount, amount, datetime.now(timezone.utc).isoformat()))
        await log_tx(db, uid, "check_create", -amount, f"token={token}")
        await db.commit()
    return token


async def claim_check(message: Message, token: str):
    await register_user(message.from_user)
    uid = message.from_user.id
    async with aiosqlite.connect(DB_PATH) as db:
        await db.execute("BEGIN IMMEDIATE")
        db.row_factory = aiosqlite.Row
        cur = await db.execute("SELECT * FROM checks WHERE token=?", (token,))
        check = await cur.fetchone()
        if not check or check["status"] != "open" or check["remaining"] <= 0:
            await db.rollback()
            await message.answer("Этот чек уже закрыт или не существует.")
            return
        if check["creator_id"] == uid:
            await db.rollback()
            await message.answer("Нельзя активировать собственный чек.")
            return
        # Single-use check: all amount goes to the first claimant.
        await db.execute("UPDATE users SET balance=balance+? WHERE user_id=?",
                         (check["remaining"], uid))
        await db.execute("UPDATE checks SET remaining=0,claims=claims+1,status='claimed' WHERE token=?",
                         (token,))
        await log_tx(db, uid, "check_claim", check["remaining"], f"token={token}")
        await db.commit()
        amount = check["remaining"]
    await message.answer(f"🎉 Чек активирован! На баланс зачислено <b>{money(amount)} ENEX</b>.",
                         parse_mode="HTML")


