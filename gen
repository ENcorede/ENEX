def create_amount_image(amount):
    img = Image.new("RGB", (900, 420), (12, 39, 85))
    draw = ImageDraw.Draw(img)

    for x in range(900):
        shade = int(20 + 30 * x / 900)
        draw.line((x, 0, x, 420), fill=(10, 30 + shade, 90 + shade))

    draw.rounded_rectangle(
        (25, 25, 875, 395),
        radius=42,
        outline=(94, 173, 255),
        width=4
    )

    try:
        font_big = ImageFont.truetype(
            "/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf", 88
        )
        font_small = ImageFont.truetype(
            "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf", 34
        )
    except OSError:
        font_big = ImageFont.load_default()
        font_small = ImageFont.load_default()

    title = "ENEX"
    box = draw.textbbox((0, 0), title, font=font_small)
    draw.text(((900 - (box[2] - box[0])) / 2, 90), title,
              font=font_small, fill=(205, 229, 255))

    amount_text = f"{amount:,}".replace(",", " ")
    box = draw.textbbox((0, 0), amount_text, font=font_big)
    draw.text(((900 - (box[2] - box[0])) / 2, 160),
              amount_text, font=font_big, fill=(255, 255, 255))

    bio = io.BytesIO()
    img.save(bio, format="PNG")
    bio.seek(0)
    return bio.getvalue()


async def send_amount_image(chat_id, amount, caption):
    image_bytes = create_amount_image(amount)
    await bot.send_photo(
        chat_id,
        BufferedInputFile(image_bytes, filename="enex.png"),
        caption=caption
    )


