@dp.message(F.text.regexp(r"(?i)^чек\s+\d+$"))
async def create_receipt(message: Message):
    amount = int(message.text.split()[1])
    user_id = message.from_user.id

    if amount <= 0:
        await message.answer("❌ Сумма должна быть больше нуля.")
        return

    code = generate_code()

    async with aiosqlite.connect(DB_PATH) as db:
        await db.execute("BEGIN IMMEDIATE")

        cur = await db.execute(
            "SELECT balance FROM users WHERE user_id = ?",
            (user_id,),
        )
        row = await cur.fetchone()

        if not row or row[0] < amount:
            await db.rollback()
            await message.answer("❌ Недостаточно ENEX.")
            return

        await db.execute(
            "UPDATE users SET balance = balance - ? WHERE user_id = ?",
            (amount, user_id),
        )

        await db.execute("""
            INSERT INTO receipts (
                code, owner_id, amount, created_at
            )
            VALUES (?, ?, ?, ?)
        """, (code, user_id, amount, now()))

        await log_transaction(
            db, user_id, None, amount, 0, "receipt_create"
        )

        await db.commit()

    image_bytes = make_card_image(code, amount, "ENEX CHECK")

    await message.answer_photo(
        BufferedInputFile(image_bytes, filename="enex_check.png"),
        caption=(
            "🎫 <b>Чек создан!</b>\n\n"
            f"Сумма: <b>{amount} ENEX</b>\n"
            f"Код: <code>{code}</code>\n\n"
            "Передай код получателю. Первый пользователь, "
            "который активирует чек, получит токены."
        ),
        parse_mode="HTML",
    )


