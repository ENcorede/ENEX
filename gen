@dp.message(Command("transfer"))
async def transfer_command(message: Message):
    await ensure_user(message.from_user)
    parts = message.text.split()

    if len(parts) != 3:
        await message.answer(
            "Использование: <code>/transfer @username сумма</code>",
            parse_mode="HTML"
        )
        return

    target = await resolve_user(parts[1])
    amount = parse_amount(parts[2])

    if not target or not amount:
        await message.answer("Не удалось найти получателя или сумму.")
        return

    sender_id = message.from_user.id
    receiver_id = target["user_id"]

    if sender_id == receiver_id:
        await message.answer("Нельзя переводить самому себе.")
        return

    if target["blocked"]:
        await message.answer("Получатель недоступен.")
        return

    if not target["allow_incoming"]:
        await message.answer("Получатель запретил входящие переводы.")
        return

    fee = (amount * TRANSFER_FEE_PERCENT + 99) // 100
    total = amount + fee

    async with aiosqlite.connect(DB_PATH) as conn:
        await conn.execute("BEGIN IMMEDIATE")

        cur = await conn.execute(
            "SELECT balance FROM users WHERE user_id=?",
            (sender_id,)
        )
        sender = await cur.fetchone()

        if not sender or sender[0] < total:
            await conn.rollback()
            await message.answer(
                f"Недостаточно средств.\n"
                f"Сумма: {amount} ENEX\n"
                f"Комиссия: {fee} ENEX\n"
                f"Всего: {total} ENEX"
            )
            return

        await conn.execute(
            "UPDATE users SET balance=balance-? WHERE user_id=?",
            (total, sender_id)
        )
        await conn.execute(
            "UPDATE users SET balance=balance+? WHERE user_id=?",
            (amount, receiver_id)
        )

        await log_transaction(
            conn, sender_id, -total, "transfer_out",
            f"Перевод пользователю {receiver_id}; комиссия {fee}"
        )
        await log_transaction(
            conn, receiver_id, amount, "transfer_in",
            f"Перевод от пользователя {sender_id}"
        )
        await conn.commit()

    await message.answer(
        f"✅ Перевод выполнен.\n\n"
        f"Получатель: {html.escape(target['first_name'] or str(receiver_id))}\n"
        f"Получено: <b>{amount:,} ENEX</b>\n"
        f"Комиссия: {fee:,} ENEX\n"
        f"Списано: {total:,} ENEX",
        parse_mode="HTML"
    )

    try:
        await bot.send_message(
            receiver_id,
            f"💸 Вам поступило <b>{amount:,} ENEX</b>.",
            parse_mode="HTML"
        )
    except TelegramAPIError:
        pass


