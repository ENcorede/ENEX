@dp.callback_query(F.data.startswith("payreq:"))
async def pay_request(callback: CallbackQuery):
    await ensure_user(callback.from_user)
    request_id = int(callback.data.split(":")[1])

    async with aiosqlite.connect(DB_PATH) as conn:
        await conn.execute("BEGIN IMMEDIATE")
        conn.row_factory = aiosqlite.Row

        cur = await conn.execute(
            "SELECT * FROM money_requests WHERE id=?",
            (request_id,)
        )
        req = await cur.fetchone()

        if (
            not req
            or req["status"] != "pending"
            or req["target_id"] != callback.from_user.id
        ):
            await conn.rollback()
            await callback.answer("Запрос недоступен.", show_alert=True)
            return

        cur = await conn.execute(
            "SELECT balance FROM users WHERE user_id=?",
            (callback.from_user.id,)
        )
        sender = await cur.fetchone()

        cur = await conn.execute(
            "SELECT allow_incoming, blocked FROM users WHERE user_id=?",
            (req["requester_id"],)
        )
        receiver = await cur.fetchone()

        amount = req["amount"]
        fee = (amount * TRANSFER_FEE_PERCENT + 99) // 100
        total = amount + fee

        if not sender or sender["balance"] < total:
            await conn.rollback()
            await callback.answer("Недостаточно средств с учётом комиссии.", show_alert=True)
            return

        if not receiver or receiver["blocked"] or not receiver["allow_incoming"]:
            await conn.rollback()
            await callback.answer("Получатель не принимает переводы.", show_alert=True)
            return

        await conn.execute(
            "UPDATE users SET balance=balance-? WHERE user_id=?",
            (total, callback.from_user.id)
        )
        await conn.execute(
            "UPDATE users SET balance=balance+? WHERE user_id=?",
            (amount, req["requester_id"])
        )
        await conn.execute(
            "UPDATE money_requests SET status='paid' WHERE id=?",
            (request_id,)
        )

        await log_transaction(
            conn, callback.from_user.id, -total,
            "request_paid", f"Оплачен запрос {request_id}; комиссия {fee}"
        )
        await log_transaction(
            conn, req["requester_id"], amount,
            "request_received", f"Получен запрос {request_id}"
        )
        await conn.commit()

    await safe_edit(
        callback.message,
        f"✅ Запрос оплачен.\nСписано: {total:,} ENEX\n"
        f"Комиссия: {fee:,} ENEX",
        back_keyboard()
    )
    await callback.answer("Оплата прошла")


