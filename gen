def find_font(size: int):
    candidates = [
        "/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf",
        "/usr/share/fonts/truetype/liberation2/LiberationSans-Bold.ttf",
        "C:/Windows/Fonts/arialbd.ttf",
    ]

    for path in candidates:
        if os.path.exists(path):
            return ImageFont.truetype(path, size)

    return ImageFont.load_default()


def make_card_image(code: str, amount: int, title="ENEX CARD"):
    width, height = 1100, 650

    image = Image.new("RGB", (width, height), "#071A38")
    draw = ImageDraw.Draw(image)

    # Синий градиент.
    for y in range(height):
        t = y / height

        color = (
            int(5 + 10 * t),
            int(35 + 45 * t),
            int(85 + 75 * t),
        )

        draw.line((0, y, width, y), fill=color)

    # Декоративные круги.
    draw.ellipse(
        (760, -170, 1250, 320),
        outline="#5EA9FF",
        width=8,
    )

    draw.ellipse(
        (820, -100, 1180, 260),
        outline="#2D79E8",
        width=5,
    )

    draw.rounded_rectangle(
        (35, 35, width - 35, height - 35),
        radius=35,
        outline="#6EB7FF",
        width=3,
    )

    title_font = find_font(48)
    code_font = find_font(51)
    amount_font = find_font(68)
    small_font = find_font(28)

    draw.text(
        (75, 80),
        title,
        font=title_font,
        fill="white",
    )

    draw.text(
        (75, 195),
        code,
        font=code_font,
        fill="white",
    )

    draw.text(
        (75, 320),
        f"{amount} ENEX",
        font=amount_font,
        fill="white",
    )

    draw.text(
        (75, 510),
        "DIGITAL TOKEN WALLET",
        font=small_font,
        fill="#B8D9FF",
    )

    output = io.BytesIO()
    image.save(output, format="PNG")
    output.seek(0)

    return output.getvalue()


