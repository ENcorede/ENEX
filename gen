async def accept_request(message: Message, token: str):
    await register_user(message.from_user)
    uid = message.from_user.id
    async with aiosqlite.connect(DB_PATH) as db:
        db.row_factory = aiosqlite.Row
        cur = await db.execute("SELECT * FROM requests WHERE token=?", (token,))
        req = await cur.fetchone()
    if not req or req["status"] != "open":
        await message.answer("Запрос уже закрыт или не существует.")
        return
    if req["creator_id"] == uid:
        await message.answer("Это твой запрос.")
        return
    if req["target_id"] and req["target_id"] != uid:
        await message.answer("Этот запрос предназначен другому пользователю.")
        return
    # Pay the requester through the same 5% transfer fee rules.
    creator = await get_user(req["creator_id"])
    if not creator:
        await message.answer("Автор запроса больше не активен.")
        return
    fake_message = message
    # Use IDs directly, atomically.
    amount = req["amount"]
    fee = (amount * FEE_PERCENT + 99) // 100
    total = amount + fee
    async with aiosqlite.connect(DB_PATH) as db:
        await db.execute("BEGIN IMMEDIATE")
        cur = await db.execute("SELECT balance,transfers_enabled,active FROM users WHERE user_id=?", (uid,))
        payer = await cur.fetchone()
        cur = await db.execute("SELECT active FROM users WHERE user_id=?", (req["creator_id"],))
        payee = await cur.fetchone()
        cur = await db.execute("SELECT status FROM requests WHERE token=?", (token,))
        status = await cur.fetchone()
        if (not payer or payer[0] < total or not payer[2] or not payee or not payee[0]
                or not status or status[0] != "open"):
            await db.rollback()
            await message.answer(f"Не удалось оплатить. Проверь баланс: нужно {money(total)} ENEX с комиссией.")
            return
        # Recipient's transfer preference applies to incoming transfers.
        cur = await db.execute("SELECT transfers_enabled FROM users WHERE user_id=?", (req["creator_id"],))
        setting = await cur.fetchone()
        if not setting or not setting[0]:
            await db.rollback()
            await message.answer("У автора запроса отключены входящие переводы.")
            return
        await db.execute("UPDATE users SET balance=balance-? WHERE user_id=?", (total, uid))
        await db.execute("UPDATE users SET balance=balance+? WHERE user_id=?", (amount, req["creator_id"]))
        await db.execute("UPDATE requests SET status='paid' WHERE token=?", (token,))
        await log_tx(db, uid, "request_paid", -total, f"token={token};fee={fee}")
        await log_tx(db, req["creator_id"], "request_received", amount, f"token={token}")
        await db.commit()
    await message.answer(f"✅ Запрос оплачен. Списано {money(total)} ENEX, включая комиссию {money(fee)}.")


