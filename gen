@dp.message(F.text.regexp(r"^[A-Z0-9]{4}(?:-[A-Z0-9]{4}){2}$"))
async def redeem_code(message: Message):
    code = message.text.strip().upper()
    user_id = message.from_user.id

    async with aiosqlite.connect(DB_PATH) as db:
        await db.execute("BEGIN IMMEDIATE")

        cur = await db.execute(
            "SELECT * FROM cards WHERE code = ?",
            (code,),
        )
        card = await cur.fetchone()

        if card:
            _, owner_id, amount, activated, created_at = card

            if activated:
                await db.rollback()
                await message.answer("❌ Эта карточка уже активирована.")
                return

            if owner_id == user_id:
                await db.rollback()
                await message.answer(
                    "ℹ️ Эта карточка уже принадлежит тебе."
                )
                return

            await db.execute(
                "UPDATE users SET balance = balance + ? WHERE user_id = ?",
                (amount, user_id),
            )

            await db.execute(
                "UPDATE cards SET activated = 1 WHERE code = ?",
                (code,),
            )

            await log_transaction(
                db,
                owner_id,
                user_id,
                amount,
                0,
                "card_redeem",
            )

            await db.commit()

            await message.answer(
                f"✅ Карточка активирована!\n\n"
                f"Получено: <b>{amount} ENEX</b>",
                parse_mode="HTML",
            )
            return

        cur = await db.execute(
            "SELECT owner_id, amount, redeemed FROM receipts WHERE code = ?",
            (code,),
        )
        receipt = await cur.fetchone()

        if not receipt:
            await db.rollback()
            await message.answer("❌ Код не найден.")
            return

        owner_id, amount, redeemed = receipt

        if redeemed:
            await db.rollback()
            await message.answer("❌ Этот чек уже использован.")
            return

        if owner_id == user_id:
            await db.rollback()
            await message.answer("❌ Нельзя погасить собственный чек.")
            return

        cur = await db.execute(
            "SELECT balance FROM users WHERE user_id = ?",
            (owner_id,),
        )
        sender = await cur.fetchone()

        if not sender or sender[0] < amount:
            await db.rollback()
            await message.answer("❌ У создателя чека недостаточно средств.")
            return

        await db.execute(
            "UPDATE users SET balance = balance - ? WHERE user_id = ?",
            (amount, owner_id),
        )

        await db.execute(
            "UPDATE users SET balance = balance + ? WHERE user_id = ?",
            (amount, user_id),
        )

        await db.execute(
            "UPDATE receipts SET redeemed = 1 WHERE code = ?",
            (code,),
        )

        await log_transaction(
            db,
            owner_id,
            user_id,
            amount,
            0,
            "receipt_redeem",
        )

        await db.commit()

    await message.answer(
        f"🎉 Чек погашен!\nПолучено: <b>{amount} ENEX</b>",
        parse_mode="HTML",
    )


