@dp.message(F.text.regexp(r"^@[A-Za-z0-9_]{5,32}\s+\d+$"))
async def transfer_handler(message: Message):
    parts = message.text.split()

    username = parts[0].lstrip("@").lower()
    amount = int(parts[1])

    sender_id = message.from_user.id

    if amount <= 0:
        await message.answer("❌ Сумма должна быть больше нуля.")
        return

    if amount > 10**12:
        await message.answer("❌ Слишком большая сумма.")
        return

    recipient = await find_username(username)

    if not recipient:
        await message.answer(
            "❌ Пользователь не найден. Он должен сначала запустить бота."
        )
        return

    receiver_id = recipient["user_id"]

    if receiver_id == sender_id:
        await message.answer("❌ Нельзя перевести ENEX самому себе.")
        return

    if not recipient["transfers_enabled"]:
        await message.answer(
            "❌ Получатель отключил приём переводов."
        )
        return

    fee = (amount * TRANSFER_FEE_PERCENT + 99) // 100
    total = amount + fee

    async with aiosqlite.connect(DB_PATH) as db:
        await db.execute("BEGIN IMMEDIATE")

        cur = await db.execute(
            "SELECT balance FROM users WHERE user_id = ?",
            (sender_id,),
        )
        sender = await cur.fetchone()

        if not sender or sender[0] < total:
            await db.rollback()
            await message.answer(
                f"❌ Недостаточно средств.\n"
                f"Сумма: {amount} ENEX\n"
                f"Комиссия: {fee} ENEX\n"
                f"Всего: {total} ENEX"
            )
            return

        await db.execute(
            "UPDATE users SET balance = balance - ? WHERE user_id = ?",
            (total, sender_id),
        )

        await db.execute(
            "UPDATE users SET balance = balance + ? WHERE user_id = ?",
            (amount, receiver_id),
        )

        await log_transaction(
            db,
            sender_id,
            receiver_id,
            amount,
            fee,
            "transfer",
        )

        await db.commit()

    await message.answer(
        f"✅ <b>Перевод выполнен!</b>\n\n"
        f"Получатель: @{username}\n"
        f"Сумма: {amount} ENEX\n"
        f"Комиссия: {fee} ENEX\n"
        f"Списано: {total} ENEX",
        parse_mode="HTML",
    )

    try:
        await bot.send_message(
            receiver_id,
            f"💸 Тебе поступило {amount} ENEX от "
            f"@{message.from_user.username or 'пользователя'}!",
        )
    except Exception:
        pass


