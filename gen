            "INSERT INTO promo_uses(code, user_id, created_at) VALUES(?, ?, ?)",
            (code, message.from_user.id, now())
        )
        await conn.execute(
            "UPDATE promo_codes SET activations=activations+1 WHERE code=?",
            (code,)
        )
        await conn.execute(
            "UPDATE users SET balance=balance+? WHERE user_id=?",
            (promo["amount"], message.from_user.id)
        )
        await log_transaction(
            conn, message.from_user.id, promo["amount"],
