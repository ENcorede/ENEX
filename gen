async def init_db():
    async with aiosqlite.connect(DB_PATH) as db:
        await db.execute("""
            CREATE TABLE IF NOT EXISTS users (
                user_id INTEGER PRIMARY KEY,
                username TEXT,
                balance INTEGER NOT NULL DEFAULT 0,
                transfers_enabled INTEGER NOT NULL DEFAULT 1,
                created_at TEXT NOT NULL
            )
        """)

        await db.execute("""
            CREATE TABLE IF NOT EXISTS cards (
                code TEXT PRIMARY KEY,
                owner_id INTEGER NOT NULL,
                amount INTEGER NOT NULL,
                activated INTEGER NOT NULL DEFAULT 0,
                created_at TEXT NOT NULL
            )
        """)

        await db.execute("""
            CREATE TABLE IF NOT EXISTS receipts (
                code TEXT PRIMARY KEY,
                owner_id INTEGER NOT NULL,
                amount INTEGER NOT NULL,
                redeemed INTEGER NOT NULL DEFAULT 0,
                created_at TEXT NOT NULL
            )
        """)

        await db.execute("""
            CREATE TABLE IF NOT EXISTS requests (
                request_id INTEGER PRIMARY KEY AUTOINCREMENT,
                requester_id INTEGER NOT NULL,
                target_id INTEGER,
                amount INTEGER NOT NULL,
                status TEXT NOT NULL DEFAULT 'pending',
                created_at TEXT NOT NULL
            )
        """)

        await db.execute("""
            CREATE TABLE IF NOT EXISTS transactions (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                sender_id INTEGER,
                receiver_id INTEGER,
                amount INTEGER NOT NULL,
                fee INTEGER NOT NULL DEFAULT 0,
                operation TEXT NOT NULL,
                created_at TEXT NOT NULL
            )
        """)

        await db.execute("""
            CREATE TABLE IF NOT EXISTS star_payments (
                payload TEXT PRIMARY KEY,
                user_id INTEGER NOT NULL,
                stars INTEGER NOT NULL,
                amount INTEGER NOT NULL,
                status TEXT NOT NULL DEFAULT 'pending',
                telegram_charge_id TEXT,
                created_at TEXT NOT NULL
            )
        """)

        await db.commit()


def now():
    return datetime.now(timezone.utc).isoformat()


async def get_user(user_id: int):
    async with aiosqlite.connect(DB_PATH) as db:
        db.row_factory = aiosqlite.Row
        cur = await db.execute(
            "SELECT * FROM users WHERE user_id = ?",
            (user_id,),
        )
        return await cur.fetchone()


async def register_user(user_id: int, username: str | None):
    async with aiosqlite.connect(DB_PATH) as db:
        await db.execute("""
            INSERT INTO users (
                user_id, username, balance, created_at
            )
            VALUES (?, ?, ?, ?)
            ON CONFLICT(user_id)
            DO UPDATE SET username = excluded.username
        """, (
            user_id,
            username.lower() if username else None,
            START_BALANCE,
            now(),
        ))
        await db.commit()


async def get_balance(user_id: int) -> int:
    user = await get_user(user_id)
    return int(user["balance"]) if user else 0


async def find_username(username: str):
    username = username.strip().lstrip("@").lower()

    async with aiosqlite.connect(DB_PATH) as db:
        db.row_factory = aiosqlite.Row
        cur = await db.execute(
            "SELECT * FROM users WHERE username = ?",
            (username,),
        )
        return await cur.fetchone()


async def log_transaction(
    db,
    sender_id,
    receiver_id,
    amount,
    fee,
    operation,
):
    await db.execute("""
        INSERT INTO transactions (
            sender_id,
            receiver_id,
            amount,
            fee,
            operation,
            created_at
        )
        VALUES (?, ?, ?, ?, ?, ?)
    """, (
        sender_id,
        receiver_id,
        amount,
        fee,
        operation,
        now(),
    ))


