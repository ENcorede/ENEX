def money(n: int) -> str:
    return f"{n:,}".replace(",", " ")


def blue_card(title: str, amount: int, subtitle: str = "ENEX") -> bytes:
    """Create a simple blue card image, returned as PNG bytes."""
    im = Image.new("RGB", (1000, 520), BLUE)
    d = ImageDraw.Draw(im)
    try:
        font_big = ImageFont.truetype("DejaVuSans-Bold.ttf", 82)
        font_mid = ImageFont.truetype("DejaVuSans-Bold.ttf", 44)
        font_small = ImageFont.truetype("DejaVuSans.ttf", 30)
    except OSError:
        font_big, font_mid, font_small = ImageFont.load_default(), ImageFont.load_default(), ImageFont.load_default()
    # Decorative soft circles, no external assets needed.
    d.ellipse((760, -140, 1130, 230), fill=(48, 122, 250))
    d.ellipse((-120, 370, 180, 670), fill=(28, 91, 210))
    d.text((65, 62), "ENEX", font=font_mid, fill=WHITE)
    d.text((65, 170), title, font=font_small, fill=(224, 237, 255))
    d.text((65, 230), money(amount), font=font_big, fill=WHITE)
    d.text((70, 390), subtitle, font=font_mid, fill=WHITE)
    out = io.BytesIO()
    im.save(out, format="PNG")
    return out.getvalue()


async def init_db():
    async with aiosqlite.connect(DB_PATH) as db:
        await db.execute("""
        CREATE TABLE IF NOT EXISTS users(
            user_id INTEGER PRIMARY KEY, username TEXT, first_name TEXT,
            balance INTEGER NOT NULL DEFAULT 0, active INTEGER NOT NULL DEFAULT 1,
            transfers_enabled INTEGER NOT NULL DEFAULT 1,
            created_at TEXT NOT NULL
        )""")
        await db.execute("""
        CREATE TABLE IF NOT EXISTS transactions(
            id INTEGER PRIMARY KEY AUTOINCREMENT, user_id INTEGER NOT NULL,
            kind TEXT NOT NULL, amount INTEGER NOT NULL, details TEXT,
            created_at TEXT NOT NULL
        )""")
        await db.execute("""
        CREATE TABLE IF NOT EXISTS checks(
            token TEXT PRIMARY KEY, creator_id INTEGER NOT NULL,
            amount INTEGER NOT NULL, remaining INTEGER NOT NULL,
            max_claims INTEGER NOT NULL DEFAULT 1, claims INTEGER NOT NULL DEFAULT 0,
            status TEXT NOT NULL DEFAULT 'open', created_at TEXT NOT NULL
        )""")
        await db.execute("""
        CREATE TABLE IF NOT EXISTS requests(
            token TEXT PRIMARY KEY, creator_id INTEGER NOT NULL,
            target_id INTEGER, amount INTEGER NOT NULL,
            status TEXT NOT NULL DEFAULT 'open', created_at TEXT NOT NULL
        )""")
        await db.execute("""
        CREATE TABLE IF NOT EXISTS payments(
            charge_id TEXT PRIMARY KEY, user_id INTEGER NOT NULL,
            stars INTEGER NOT NULL, enex INTEGER NOT NULL, created_at TEXT NOT NULL
        )""")
        await db.execute("""
        CREATE TABLE IF NOT EXISTS promos(
            code TEXT PRIMARY KEY, amount INTEGER NOT NULL,
            max_uses INTEGER NOT NULL, uses INTEGER NOT NULL DEFAULT 0,
            active INTEGER NOT NULL DEFAULT 1, created_by INTEGER NOT NULL,
            created_at TEXT NOT NULL
        )""")
        await db.execute("""
        CREATE TABLE IF NOT EXISTS promo_uses(
            code TEXT NOT NULL, user_id INTEGER NOT NULL,
            created_at TEXT NOT NULL, PRIMARY KEY(code, user_id)
        )""")
        await db.commit()


async def register_user(user):
    if not user:
        return
    async with aiosqlite.connect(DB_PATH) as db:
        await db.execute("""
        INSERT INTO users(user_id, username, first_name, created_at)
        VALUES(?,?,?,?)
        ON CONFLICT(user_id) DO UPDATE SET username=excluded.username,
          first_name=excluded.first_name
        """, (user.id, (user.username or "").lower(), user.first_name or "",
              datetime.now(timezone.utc).isoformat()))
        await db.commit()


async def get_user(user_id: int):
    async with aiosqlite.connect(DB_PATH) as db:
        db.row_factory = aiosqlite.Row
        cur = await db.execute("SELECT * FROM users WHERE user_id=?", (user_id,))
        return await cur.fetchone()


async def find_username(username: str):
    username = username.lstrip("@").lower()
    async with aiosqlite.connect(DB_PATH) as db:
        db.row_factory = aiosqlite.Row
        cur = await db.execute(
            "SELECT * FROM users WHERE username=? AND active=1", (username,))
        return await cur.fetchone()


async def log_tx(db, user_id, kind, amount, details=""):
    await db.execute(
        "INSERT INTO transactions(user_id,kind,amount,details,created_at) VALUES(?,?,?,?,?)",
        (user_id, kind, amount, details, datetime.now(timezone.utc).isoformat())
    )


