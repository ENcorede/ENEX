@dp.message(Command("transfer"))
async def transfer_cmd(message: Message):
    await register_user(message.from_user)
    parts = (message.text or "").split()
    if len(parts) != 3 or not parts[1].startswith("@") or not parts[2].isdigit():
        await message.answer("Формат: <code>/transfer @username 100</code>", parse_mode="HTML")
        return
    await do_transfer(message, parts[1], int(parts[2]))


async def do_transfer(message: Message, username: str, amount: int):
    sender_id = message.from_user.id
    if amount <= 0:
        await message.answer("Сумма должна быть больше нуля.")
        return
    recipient = await find_username(username)
    if not recipient:
        await message.answer("Не нашёл активного пользователя. Он должен запустить бота и иметь username.")
        return
    if recipient["user_id"] == sender_id:
        await message.answer("Нельзя перевести ENEX самому себе.")
        return
    if not recipient["transfers_enabled"]:
        await message.answer("У пользователя отключены входящие переводы.")
        return
    fee = (amount * FEE_PERCENT + 99) // 100
    total = amount + fee
    async with aiosqlite.connect(DB_PATH) as db:
        await db.execute("BEGIN IMMEDIATE")
        cur = await db.execute("SELECT balance,active FROM users WHERE user_id=?", (sender_id,))
        sender = await cur.fetchone()
        if not sender or not sender[1] or sender[0] < total:
            await db.rollback()
            await message.answer(f"Недостаточно средств. Нужно {money(total)} ENEX "
                                 f"(сумма {money(amount)} + комиссия {money(fee)}).")
            return
        await db.execute("UPDATE users SET balance=balance-? WHERE user_id=?", (total, sender_id))
        await db.execute("UPDATE users SET balance=balance+? WHERE user_id=?",
                         (amount, recipient["user_id"]))
        await log_tx(db, sender_id, "transfer_out", -total,
                     f"to={recipient['user_id']};amount={amount};fee={fee}")
        await log_tx(db, recipient["user_id"], "transfer_in", amount, f"from={sender_id}")
        await db.commit()
    await message.answer(
        f"✅ Перевод выполнен\nПолучатель: @{recipient['username']}\n"
        f"Отправлено: <b>{money(amount)} ENEX</b>\n"
        f"Комиссия 5%: {money(fee)} ENEX\nСписано всего: {money(total)} ENEX",
        parse_mode="HTML")


