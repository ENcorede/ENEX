@dp.message(Command("check"))
async def create_check(message: Message):
    await ensure_user(message.from_user)
    parts = message.text.split()

    if len(parts) != 2:
        await message.answer("Использование: /check сумма")
        return

    amount = parse_amount(parts[1])
    if not amount:
        await message.answer("Укажи положительную целую сумму.")
        return

    code = secrets.token_urlsafe(8).replace("-", "").replace("_", "")
    code = code[:12].upper()

    async with aiosqlite.connect(DB_PATH) as conn:
        await conn.execute("BEGIN IMMEDIATE")
        cur = await conn.execute(
            "SELECT balance FROM users WHERE user_id=?",
            (message.from_user.id,)
        )
        row = await cur.fetchone()

        if not row or row[0] < amount:
            await conn.rollback()
            await message.answer("Недостаточно ENEX для создания чека.")
            return

        await conn.execute(
            "UPDATE users SET balance=balance-? WHERE user_id=?",
            (amount, message.from_user.id)
        )
        await conn.execute("""
            INSERT INTO checks(code, creator_id, amount, status, created_at)
            VALUES(?, ?, ?, 'active', ?)
        """, (code, message.from_user.id, amount, now()))

        await log_transaction(
            conn, message.from_user.id, -amount,
            "check_create", f"Создан чек {code}"
        )
        await conn.commit()

    await send_amount_image(
        message.chat.id,
        amount,
        f"🧾 <b>Чек ENEX</b>\n\n"
        f"Сумма: <b>{amount:,} ENEX</b>\n"
        f"Код: <code>{code}</code>\n\n"
        f"Передай это сообщение тому, кто должен получить средства."
    )
    await message.answer(
        "Чтобы получить ENEX, нажмите кнопку:",
        reply_markup=check_keyboard(code)
    )


@dp.callback_query(F.data.startswith("claim:"))
async def claim_check(callback: CallbackQuery):
    await ensure_user(callback.from_user)
    code = callback.data.split(":", 1)[1]

    async with aiosqlite.connect(DB_PATH) as conn:
        await conn.execute("BEGIN IMMEDIATE")
        conn.row_factory = aiosqlite.Row
        cur = await conn.execute(
            "SELECT * FROM checks WHERE code=?",
            (code,)
        )
        check = await cur.fetchone()

        if not check or check["status"] != "active":
            await conn.rollback()
            await callback.answer("Этот чек уже использован или недоступен.", show_alert=True)
            return

        if check["creator_id"] == callback.from_user.id:
            await conn.rollback()
            await callback.answer("Нельзя активировать собственный чек.", show_alert=True)
            return

        cur = await conn.execute(
            "SELECT allow_incoming, blocked FROM users WHERE user_id=?",
            (callback.from_user.id,)
        )
        user = await cur.fetchone()

        if not user or user["blocked"] or not user["allow_incoming"]:
            await conn.rollback()
            await callback.answer("Получение переводов отключено.", show_alert=True)
            return

        await conn.execute(
            "UPDATE checks SET status='claimed', claimed_by=? WHERE code=?",
            (callback.from_user.id, code)
        )
        await conn.execute(
            "UPDATE users SET balance=balance+? WHERE user_id=?",
            (check["amount"], callback.from_user.id)
        )
        await log_transaction(
            conn, callback.from_user.id, check["amount"],
            "check_claim", f"Получен чек {code}"
        )
        await conn.commit()

    await callback.answer("Чек активирован!")
    await safe_edit(
        callback.message,
        f"✅ Чек получен!\n\n"
        f"Начислено: <b>{check['amount']:,} ENEX</b>",
        back_keyboard()
    )


