@dp.message(F.text.regexp(r"(?i)^выдать\s+\d+\s+\d+$"))
async def admin_give_handler(message: Message):
    if message.from_user.id not in ADMIN_IDS:
        return

    _, raw_user_id, raw_amount = message.text.split()

    target_id = int(raw_user_id)
    amount = int(raw_amount)

    if amount <= 0:
        await message.answer("❌ Сумма должна быть положительной.")
        return

    async with aiosqlite.connect(DB_PATH) as db:
        cur = await db.execute(
            "SELECT user_id FROM users WHERE user_id = ?",
            (target_id,),
        )
        target = await cur.fetchone()

        if not target:
            await message.answer(
                "❌ Пользователь ещё не запускал бота."
            )
            return

        await db.execute(
            "UPDATE users SET balance = balance + ? WHERE user_id = ?",
            (amount, target_id),
        )

        await log_transaction(
            db, None, target_id, amount, 0, "admin_credit"
        )

        await db.commit()

    await message.answer(
        f"✅ Выдано {amount} ENEX пользователю {target_id}."
    )


