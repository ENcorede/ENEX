@dp.message(F.text.regexp(
    r"(?i)^запрос\s+@[A-Za-z0-9_]{5,32}\s+\d+$"
))
async def request_money_handler(message: Message):
    parts = message.text.split()

    username = parts[1].lstrip("@").lower()
    amount = int(parts[2])

    if amount <= 0:
        await message.answer("❌ Сумма должна быть больше нуля.")
        return

    target = await find_username(username)

    if not target:
        await message.answer(
            "❌ Получатель запроса не найден. "
            "Он должен запустить бота."
        )
        return

    if target["user_id"] == message.from_user.id:
        await message.answer("❌ Нельзя запросить деньги у себя.")
        return

    async with aiosqlite.connect(DB_PATH) as db:
        cur = await db.execute("""
            INSERT INTO requests (
                requester_id, target_id, amount, status, created_at
            )
            VALUES (?, ?, ?, 'pending', ?)
        """, (
            message.from_user.id,
            target["user_id"],
            amount,
            now(),
        ))
        request_id = cur.lastrowid
        await db.commit()

    kb = InlineKeyboardMarkup(inline_keyboard=[
        [
            InlineKeyboardButton(
                text="💸 Оплатить",
                callback_data=f"payreq:{request_id}",
            )
        ]
    ])

    try:
        await bot.send_message(
            target["user_id"],
            f"📩 <b>Запрос денег</b>\n\n"
            f"От: @{message.from_user.username or 'пользователя'}\n"
            f"Сумма: {amount} ENEX",
            reply_markup=kb,
            parse_mode="HTML",
        )
    except Exception:
        await message.answer(
            "Запрос создан, но уведомление не доставлено."
        )
        return

    await message.answer("✅ Запрос отправлен.")


@dp.callback_query(F.data.startswith("payreq:"))
async def pay_request(call: CallbackQuery):
    request_id = int(call.data.split(":")[1])
    user_id = call.from_user.id

    async with aiosqlite.connect(DB_PATH) as db:
        await db.execute("BEGIN IMMEDIATE")

        cur = await db.execute("""
            SELECT requester_id, target_id, amount, status
            FROM requests
            WHERE request_id = ?
        """, (request_id,))
        req = await cur.fetchone()

        if (
            not req
            or req[1] != user_id
            or req[3] != "pending"
        ):
            await db.rollback()
            await call.answer(
                "Запрос недоступен.",
                show_alert=True,
            )
            return

        requester_id, target_id, amount, status = req

        cur = await db.execute(
            "SELECT balance FROM users WHERE user_id = ?",
            (user_id,),
        )
        sender = await cur.fetchone()

        if not sender or sender[0] < amount:
            await db.rollback()
            await call.answer(
                "Недостаточно ENEX.",
                show_alert=True,
            )
            return

        cur = await db.execute(
            "SELECT transfers_enabled FROM users WHERE user_id = ?",
            (requester_id,),
        )
        receiver = await cur.fetchone()

        if not receiver or not receiver[0]:
            await db.rollback()
            await call.answer(
                "Получатель отключил переводы.",
                show_alert=True,
            )
            return

        fee = (amount * TRANSFER_FEE_PERCENT + 99) // 100

        if sender[0] < amount + fee:
            await db.rollback()
            await call.answer(
                f"Нужно {amount + fee} ENEX с учётом комиссии.",
                show_alert=True,
            )
            return

        await db.execute(
            "UPDATE users SET balance = balance - ? WHERE user_id = ?",
            (amount + fee, user_id),
        )

        await db.execute(
            "UPDATE users SET balance = balance + ? WHERE user_id = ?",
            (amount, requester_id),
        )

        cur = await db.execute("""
            UPDATE requests SET status = 'paid'
            WHERE request_id = ? AND status = 'pending'
        """, (request_id,))

        if cur.rowcount != 1:
            await db.rollback()
            await call.answer(
                "Запрос уже обработан.",
                show_alert=True,
            )
            return

        await log_transaction(
            db, user_id, requester_id, amount, fee, "request_payment"
        )

        await db.commit()

    await call.answer("Запрос оплачен!")

    await call.message.edit_text(
        f"✅ Запрос №{request_id} оплачен.\n"
        f"Сумма: {amount} ENEX\n"
        f"Комиссия: {fee} ENEX"
    )

    try:
        await bot.send_message(
            requester_id,
            f"💸 Запрос оплачен! Получено {amount} ENEX."
        )
    except Exception:
        pass


